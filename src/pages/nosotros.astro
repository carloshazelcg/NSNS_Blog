---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
---

<Layout tittle="Nosotros">
    <NavBar />
    <div class="flex items-center justify-center min-h-screen" style="background-color: #1A1A1D;">
        <div class="text-center">
            <p class="text-6xl font-bold mb-4 animate-pulse" style="color: #A30000;">Próximamente...</p>
            <div class="h-1 w-32 mx-auto animate-bounce" style="background-color: #A30000;"></div>
            <p class="text-lg mt-8" style="color: #CFCFCF;">Estamos trabajando en algo especial...</p>
        </div>
    </div>
</Layout>