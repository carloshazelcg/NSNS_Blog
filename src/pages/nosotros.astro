---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="NSNS | Nosotros">
  <NavBar />
  <main class="flex flex-col items-center justify-center min-h-screen px-4 bg-[#0D0D0D] relative overflow-hidden pt-28 pb-16">
    <div class="absolute top-1/3 -left-20 w-[380px] h-[380px] bg-[#73030D]/15 rounded-full blur-[150px] pointer-events-none"></div>
    <div class="absolute bottom-1/3 -right-20 w-[300px] h-[300px] bg-[#732F3B]/15 rounded-full blur-[130px] pointer-events-none"></div>

    <div class="text-center relative z-10 max-w-2xl mx-auto">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4 tracking-tight text-[#F2F2F2]">
        Próximamente...
      </h1>

      <div class="h-1 w-24 sm:w-36 mx-auto bg-gradient-to-r from-[#73030D] via-[#732F3B] to-transparent rounded-full"></div>

      <p class="text-base sm:text-lg mt-8 font-normal text-[#8C8C8C] max-w-lg mx-auto leading-relaxed">
        Estamos trabajando en algo especial...      
      </p>
    </div>
  </main>

  <Footer />
</Layout>