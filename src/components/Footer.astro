---
import Logo from "../assets/IMG_9954.png";

const currentYear = new Date().getFullYear();

// Redes del Colectivo NSNS
const nsnsSocials = [
  { 
    name: "Instagram", 
    url: "https://www.instagram.com/nosenosentir_/", 
    icon: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" 
  }
];

const credits = [
  { name: "GATODELINCUENTE", instagram: "https://www.instagram.com/gatodelincuente/" },
  { name: "HOUSEK", instagram: "https://www.instagram.com/hhzzkk____/" },
  { name: "JULS", instagram: "https://www.instagram.com/okjulss/" },
  { name: "OMY", instagram: "https://www.instagram.com/oyeomy/" },
  { name: "FOKIU NIKO", instagram: "https://www.instagram.com/fokiu.niko/" },
  { name: "JOTA CE", instagram: "https://www.instagram.com/jotace.wav/" },
  { name: "KOKONOCOME", instagram: "https://www.instagram.com/kokonocome/" }
];
---

<footer class="w-full bg-[#0D0D0D] border-t border-[#732F3B]/20 text-[#8C8C8C] pt-8 pb-4 px-6 relative z-5">
  <div class="max-w-6xl mx-auto">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-8 mb-6">
      
      <div class="col-span-1 md:col-span-4 flex flex-col items-center text-center space-y-3">
        <a href="/" class="block w-fit mx-auto opacity-90 hover:opacity-100 transition-opacity">
            <img 
              src={Logo.src} 
              alt="NSNS Logo" 
              class="h-16 md:h-20 w-auto object-contain drop-shadow-xl" 
            />
        </a>

        <p class="text-[13px] leading-snug text-[#B3B3B3] max-w-[280px] font-serif italic tracking-wide">
          Plataforma de impulso musical independiente enfocada en la producción y difusión de proyectos.
        </p>
      </div>

      <div class="col-span-1 md:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-8 pt-1">
        
        <div class="flex flex-col space-y-4 items-center text-center">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#F2F2F2]/60 border-b border-[#732F3B]/30 pb-1 w-fit mx-auto">NO SÉ NO SENTIR</h4>
          <ul class="space-y-3 w-full">
            {nsnsSocials.map((social) => (
              <li class="flex justify-center w-full">
                <a href={social.url} target="_blank" rel="noopener noreferrer" class="text-[#8C8C8C] hover:text-[#E1306C] transition-colors duration-300 flex items-center justify-center gap-2 group">
                  <svg class="w-6 h-6 fill-current transform group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                    <path d={social.icon}/>
                  </svg>
                  <span class="text-[13px] font-medium tracking-wide group-hover:text-[#F2F2F2] transition-colors">{social.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col space-y-3 items-center text-center">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#F2F2F2]/60 border-b border-[#732F3B]/30 pb-1 w-fit mx-auto">El Equipo</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 w-full max-w-md">
            {credits.map((member) => (
              <div class="flex items-center justify-between w-full px-2 py-1">
                <span class="text-[#F2F2F2] font-semibold text-[11px] tracking-wide truncate text-left">{member.name}</span>
                <a href={member.instagram} target="_blank" rel="noopener noreferrer" class="text-[#8C8C8C]/50 hover:text-[#E1306C] transition-colors p-1 shrink-0 text-right" aria-label={`Instagram de ${member.name}`}>
                  <svg class="w-4 h-4 fill-current inline-block" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </a>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

    <div class="pt-4 border-t border-[#732F3B]/20 flex justify-center items-center text-[9px] text-[#8C8C8C]/40 font-sans uppercase tracking-[0.1em] text-center">
      <p>&copy; {currentYear} NO SE NO SENTIR. Todos los derechos reservados.</p>
    </div>

  </div>
</footer>