<script is:inline>
  let animacionId = 0;
  let estadoJuego = 'inactivo';

  function initJuegoDueto() {
    if (animacionId) {
      cancelAnimationFrame(animacionId);
      animacionId = 0;
    }
    estadoJuego = 'inactivo';

    const contenedorPersonaje = document.getElementById('contenedor-personaje');
    const contenedorJuego = document.getElementById('contenedor-juego');
    const videoSecreto = document.getElementById('video-secreto'); 
    const canvas = document.getElementById('lienzo-juego');
    const textoPuntos = document.getElementById('texto-puntos');
    const textoNivel = document.getElementById('texto-nivel');
    const overlayInicio = document.getElementById('overlay-inicio');

    const selP1 = document.getElementById('sel-p1');
    const selP2 = document.getElementById('sel-p2');

    if (!canvas || !videoSecreto) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let personajeSeleccionado = 1;
    let puntos = 0;
    let nivel = 1;
    let velocidadScroll = 3.0;
    let contadorFrames = 0;
    let anguloRotacion = 0;

    let jugador = { x: canvas.width / 2 - 20, y: 40, ancho: 40, alto: 40, targetX: canvas.width / 2 - 20 };
    let obstaculos = [];
    let metaFinal = { y: -300, activa: false, completada: false };

    const imgPersonaje1 = new Image();
    imgPersonaje1.src = '/ElDueto/JUEGO/CABEZANIKO.PNG';

    const imgPersonaje2 = new Image();
    imgPersonaje2.src = '/ElDueto/JUEGO/CABEZAOMY.PNG';

    const imgFondoJuego = new Image();
    imgFondoJuego.src = '/ElDueto/JUEGO/FONDO/IMG_1785.png';

    const musicaFondo = new Audio('/ElDueto/JUEGO/RINGRING.mp3');
    musicaFondo.loop = true;
    musicaFondo.volume = 0.1;

    const audioColision = new Audio('/ElDueto/JUEGO/YAMAMASTE.mp3');
    audioColision.volume = 0.2;

    let arrastrando = false;

    function manejarMovimiento(clientX) {
      const rect = canvas.getBoundingClientRect();
      const escalaX = canvas.width / rect.width;
      const xCanvas = (clientX - rect.left) * escalaX;
      jugador.targetX = xCanvas - jugador.ancho / 2;
      if (jugador.targetX < 10) jugador.targetX = 10;
      if (jugador.targetX > canvas.width - jugador.ancho - 10) jugador.targetX = canvas.width - jugador.ancho - 10;
    }

    canvas.addEventListener('mousedown', (e) => {
      arrastrando = true;
      manejarMovimiento(e.clientX);
      iniciarAccionJuego();
    });
    window.addEventListener('mousemove', (e) => {
      if (arrastrando) manejarMovimiento(e.clientX);
    });
    window.addEventListener('mouseup', () => { arrastrando = false; });

    canvas.addEventListener('touchstart', (e) => {
      arrastrando = true;
      if (e.touches.length > 0) manejarMovimiento(e.touches[0].clientX);
      iniciarAccionJuego();
      e.preventDefault();
    }, {passive: false});

    window.addEventListener('touchmove', (e) => {
      if (arrastrando && e.touches.length > 0) {
        manejarMovimiento(e.touches[0].clientX);
        e.preventDefault();
      }
    }, {passive: false});

    window.addEventListener('touchend', () => { arrastrando = false; });

    if (overlayInicio) {
      overlayInicio.addEventListener('click', () => {
        iniciarAccionJuego();
      });
      overlayInicio.addEventListener('touchstart', (e) => {
        iniciarAccionJuego();
        e.preventDefault();
      }, {passive: false});
    }

    function iniciarAccionJuego() {
      if (estadoJuego === 'esperando_inicio') {
        estadoJuego = 'jugando';
        if (overlayInicio) overlayInicio.style.display = 'none';
        musicaFondo.play().catch(err => console.log("Audio play prevented:", err));
        bucleJuego();
      } else if (estadoJuego === 'perdido') {
        reiniciarJuego();
        estadoJuego = 'jugando';
        if (overlayInicio) overlayInicio.style.display = 'none';
        musicaFondo.play().catch(err => console.log("Audio play prevented:", err));
        bucleJuego();
      }
    }

    function reiniciarJuego() {
      puntos = 0;
      nivel = 1;
      velocidadScroll = 3.0;
      contadorFrames = 0;
      anguloRotacion = 0;
      obstaculos = [];
      metaFinal = { y: -300, activa: false, completada: false };
      jugador.x = canvas.width / 2 - 20;
      jugador.targetX = jugador.x;
      jugador.y = 40;
      if (textoPuntos) textoPuntos.innerHTML = 'PTS: 0/150';
      if (textoNivel) textoNivel.innerHTML = 'NIVEL 1';
    }

    function generarObstaculo() {
      let anchoHueco = 130;
      if (nivel === 2) anchoHueco = 105;
      if (nivel === 3) anchoHueco = 90;

      const xMaxHueco = canvas.width - anchoHueco - 15;
      const xHueco = Math.random() * (xMaxHueco - 15) + 15;
      
      let velocidadLateral = 0;
      if (nivel === 2) velocidadLateral = Math.random() > 0.5 ? 1.0 : -1.0;
      if (nivel === 3) velocidadLateral = Math.random() > 0.4 ? 1.8 : -1.8;

      obstaculos.push({
        y: canvas.height + 40,
        alto: 32,
        xHueco: xHueco,
        anchoHueco: anchoHueco,
        vx: velocidadLateral
      });
    }

    function dibujarTabiquesFila(x, y, w, h) {
      if (w <= 0) return;
      ctx.save();
      ctx.beginPath();
      ctx.rect(x, y, w, h);
      ctx.clip();

      ctx.fillStyle = '#b23a25';
      ctx.fillRect(x, y, w, h);

      ctx.strokeStyle = '#000';
      ctx.lineWidth = 2;
      ctx.strokeRect(x, y, w, h);

      ctx.fillStyle = '#4a150b';
      let anchoTabique = 20;
      for (let tx = 0; tx < canvas.width; tx += anchoTabique) {
        ctx.strokeRect(tx, y, anchoTabique, h);
      }
      ctx.restore();
    }

    function bucleJuego() {
      if (estadoJuego !== 'jugando' && estadoJuego !== 'esperando_inicio') return;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (imgFondoJuego.complete && imgFondoJuego.naturalHeight !== 0) {
        const imgAspect = imgFondoJuego.naturalWidth / imgFondoJuego.naturalHeight;
        const canvasAspect = canvas.width / canvas.height;
        
        const zoom = 1; 
        let renderW, renderH, offsetX, offsetY;

        if (imgAspect > canvasAspect) {
          renderH = canvas.height * zoom;
          renderW = renderH * imgAspect;
          offsetX = (canvas.width - renderW) / 2;
          offsetY = (canvas.height - renderH) / 2;
        } else {
          renderW = canvas.width * zoom;
          renderH = renderW / imgAspect;
          offsetX = (canvas.width - renderW) / 2;
          offsetY = (canvas.height - renderH) / 2;
        }

        ctx.drawImage(imgFondoJuego, offsetX, offsetY, renderW, renderH);
      } else {
        ctx.fillStyle = '#3a2e2b';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }

      let difX = jugador.targetX - jugador.x;
      jugador.x += difX * 0.25;
      anguloRotacion = (difX * 0.03);
      if (anguloRotacion > 0.35) anguloRotacion = 0.35;
      if (anguloRotacion < -0.35) anguloRotacion = -0.35;

      if (estadoJuego === 'jugando' && !metaFinal.activa) {
        contadorFrames++;
        let frecuencia = 95;
        if (nivel === 2) frecuencia = 80;
        if (nivel === 3) frecuencia = 65;

        if (contadorFrames % frecuencia === 0) {
          generarObstaculo();
        }

        for (let i = obstaculos.length - 1; i >= 0; i--) {
          let obs = obstaculos[i];
          obs.y -= velocidadScroll;

          if (nivel >= 2) {
            obs.xHueco += obs.vx;
            if (obs.xHueco <= 0 || obs.xHueco + obs.anchoHueco >= canvas.width) {
              obs.vx *= -1;
            }
          }

          if (obs.y + obs.alto < 0) {
            obstaculos.splice(i, 1);
            puntos += 10;

            if (puntos >= 50 && nivel === 1) {
              nivel = 2;
              velocidadScroll = 4.0;
              if (textoNivel) textoNivel.innerHTML = 'NIVEL 2';
            } else if (puntos >= 100 && nivel === 2) {
              nivel = 3;
              velocidadScroll = 4.8;
              if (textoNivel) textoNivel.innerHTML = 'NIVEL 3 (¡FINAL!)';
            } else if (puntos >= 150) {
              metaFinal.activa = true;
              metaFinal.y = canvas.height + 50;
            }

            if (textoPuntos) textoPuntos.innerHTML = 'PTS: ' + puntos + '/150';
          }
        }
      }

      if (metaFinal.activa) {
        metaFinal.y -= velocidadScroll;
        ctx.fillStyle = '#ff0000';
        ctx.fillRect(20, metaFinal.y, canvas.width - 40, 40);
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 3;
        ctx.strokeRect(20, metaFinal.y, canvas.width - 40, 40);

        ctx.fillStyle = '#fff';
        ctx.font = 'bold 18px "Alfa Slab One", Impact, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText("¡META FINAL!", canvas.width / 2, metaFinal.y + 26);

        if (jugador.y < metaFinal.y + 40 && jugador.y + jugador.alto > metaFinal.y) {
          metaFinal.completada = true;
        }
      } else {
        for (let i = 0; i < obstaculos.length; i++) {
          let obs = obstaculos[i];
          
          let izqW = Math.max(0, obs.xHueco);
          if (izqW > 0) {
            dibujarTabiquesFila(0, obs.y, izqW, obs.alto);
          }

          let derX = obs.xHueco + obs.anchoHueco;
          let derW = Math.max(0, canvas.width - derX);
          if (derW > 0) {
            dibujarTabiquesFila(derX, obs.y, derW, obs.alto);
          }

          let colisionIzq = (jugador.x < izqW) && (jugador.y < obs.y + obs.alto && jugador.y + jugador.alto > obs.y);
          let colisionDer = (jugador.x + jugador.ancho > derX) && (jugador.y < obs.y + obs.alto && jugador.y + jugador.alto > obs.y);

          if (colisionIzq || colisionDer) {
            estadoJuego = 'perdido';
            musicaFondo.pause();
            audioColision.play().catch(err => console.log("Audio collision play error:", err));

            ctx.fillStyle = 'rgba(0, 0, 0, 0.85)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#ff0000';
            ctx.font = '35px "Alfa Slab One", Impact, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText("¡YA MAMASTE!", canvas.width / 2, canvas.height / 2 - 10);

            ctx.fillStyle = '#fff';
            ctx.font = 'bold 12px monospace';
            ctx.fillText("Toca o haz clic para reintentar", canvas.width / 2, canvas.height / 2 + 25);
            return;
          }
        }
      }

      ctx.save();
      ctx.translate(jugador.x + jugador.ancho / 2, jugador.y + jugador.alto / 2);
      ctx.rotate(anguloRotacion);

      let imgActual = personajeSeleccionado === 1 ? imgPersonaje1 : imgPersonaje2;
      if (imgActual.complete && imgActual.naturalHeight !== 0) {
        let aspectRatio = imgActual.naturalWidth / imgActual.naturalHeight;
        let renderAncho = 45 * aspectRatio; 
        ctx.drawImage(imgActual, -renderAncho / 2, -22, renderAncho, 45);
      } else {
        ctx.fillStyle = '#ff0000';
        ctx.fillRect(-jugador.ancho / 2, -jugador.alto / 2, jugador.ancho, jugador.alto);
      }
      ctx.restore();

      if (metaFinal.completada || puntos >= 150 && metaFinal.y + 40 < 0) {
        estadoJuego = 'inactivo';
        musicaFondo.pause();
        if (animacionId) cancelAnimationFrame(animacionId);

        contenedorJuego.classList.remove('block');
        contenedorJuego.classList.add('hidden'); 
        videoSecreto.classList.remove('hidden');
        videoSecreto.classList.add('block'); 
        return;
      }

      if (estadoJuego === 'jugando') {
        animacionId = requestAnimationFrame(bucleJuego);
      }
    }

    function elegirPersonaje(num) {
      personajeSeleccionado = num;
      if (contenedorPersonaje) contenedorPersonaje.style.display = 'none';
      if (contenedorJuego) {
        contenedorJuego.classList.remove('hidden');
        contenedorJuego.classList.add('block');
      }

      estadoJuego = 'esperando_inicio';
      reiniciarJuego();
      if (overlayInicio) overlayInicio.style.display = 'flex';
      bucleJuego();
    }

    if (selP1) selP1.addEventListener('click', () => elegirPersonaje(1));
    if (selP2) selP2.addEventListener('click', () => elegirPersonaje(2));
  }

  initJuegoDueto();
  document.addEventListener('astro:page-load', initJuegoDueto);
</script>