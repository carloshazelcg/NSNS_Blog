---
import Logo from "../assets/IMG_9954.png";

const currentYear = new Date().getFullYear();

const promoArtists = [
  { name: "OMY", spotify: "https://open.spotify.com/intl-es/artist/2zOajjKsoMMTZPhrYGmjyL?si=QLSp3i5OT3-TMRwdabfz_g", instagram: "https://www.instagram.com/oyeomy/" },
  { name: "FOKIU NIKO", spotify: "https://open.spotify.com/intl-es/artist/5PGdFFYYzVLdLWRvCenPQf?si=O27JtL81SeCVpTzu6rd88Q", instagram: "https://www.instagram.com/fokiu.niko/" },
];

const credits = [
  { name: "KOKONOCOME", role: "Dirección visual y diseño", instagram: "https://www.instagram.com/kokonocome/" },
  { name: "GATODELINCUENTE", role: "Dirección visual y diseño", instagram: "https://www.instagram.com/gatodelincuente/" },
  { name: "HOUSEK", role: "Desarrollo", instagram: "https://www.instagram.com/hhzzkk____/" }
];
---

<footer class="w-full bg-[#0D0D0D] border-t border-[#732F3B]/20 text-[#8C8C8C] pt-8 pb-4 px-6 relative z-10">
  <div class="max-w-6xl mx-auto">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-8 mb-6">
      
      <div class="col-span-1 md:col-span-4 flex flex-col items-center text-center space-y-3">
        <a href="/" class="block w-fit mx-auto opacity-90 hover:opacity-100 transition-opacity">
            <img 
              src={Logo.src} 
              alt="NSNS Logo" 
              class="h-16 md:h-20 w-auto object-contain drop-shadow-xl" 
            />
        </a>

        <p class="text-[13px] leading-snug text-[#B3B3B3] max-w-[280px] font-serif italic tracking-wide">
          Plataforma de impulso musical independiente enfocada en la producción y difusión de proyectos.
        </p>
      </div>

      <div class="col-span-1 md:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-8 pt-1">
        
        <div class="flex flex-col space-y-4 items-center text-center">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#F2F2F2]/60 border-b border-[#732F3B]/30 pb-1 w-fit flex items-center gap-1">
            Artistas <span class="text-[#73030D] text-sm leading-none">•</span>
          </h4>
          <ul class="space-y-4 w-full">
            {promoArtists.map((artist) => (
              <li class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 w-full">
                <span class="text-[#F2F2F2] font-semibold text-[13px] tracking-wide sm:w-24 sm:text-right">{artist.name}</span>
                <div class="flex items-center space-x-3 text-[#8C8C8C]/50 sm:w-24 sm:text-left">
                  <a href={artist.spotify} target="_blank" rel="noopener noreferrer" class="hover:text-[#1DB954] transition-colors p-1" aria-label={`Spotify de ${artist.name}`}>
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                      <path d="M12 0C5.376 0 0 5.377 0 12c0 6.623 5.377 12 12 12 6.622 0 12-5.377 12-12 0-6.623-5.378-12-12-12zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.899 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.019zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141 C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                    </svg>
                  </a>
                  <a href={artist.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-[#E1306C] transition-colors p-1" aria-label={`Instagram de ${artist.name}`}>
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col space-y-4 items-center text-center">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#F2F2F2]/60 border-b border-[#732F3B]/30 pb-1 w-fit">SECCIÓN CREADA POR:</h4>
          
          <div class="space-y-3 w-full">
            
            <div class="flex items-center justify-center gap-3 md:gap-4 w-full mb-3">
              <div class="flex flex-col text-right w-36 md:w-40">
                <span class="text-[#E1306C] font-extrabold text-[13px] md:text-[14px] tracking-widest uppercase leading-tight">NO SÉ NO SENTIR</span>
              </div>
              <div class="w-16 md:w-20 text-left flex items-center justify-start">
                <a href="https://www.instagram.com/nosenosentir_/" target="_blank" rel="noopener noreferrer" class="text-[#8C8C8C]/50 hover:text-[#E1306C] transition-colors p-1" aria-label="Instagram de NO SÉ NO SENTIR">
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </a>
              </div>
            </div>

            {credits.map((member) => (
              <div class="flex items-center justify-center gap-3 md:gap-4 w-full">
                <div class="flex flex-col text-right w-36 md:w-40">
                  <span class="text-[#F2F2F2] font-semibold text-[12px] tracking-wide">{member.name}</span>
                  <span class="text-[10px] text-[#8C8C8C]/80 font-serif italic">{member.role}</span>
                </div>
                <div class="w-16 md:w-20 text-left flex items-center justify-start">
                  <a href={member.instagram} target="_blank" rel="noopener noreferrer" class="text-[#8C8C8C]/50 hover:text-[#E1306C] transition-colors p-1" aria-label={`Instagram de ${member.name}`}>
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

    <div class="pt-4 border-t border-[#732F3B]/20 flex justify-center items-center text-[9px] text-[#8C8C8C]/40 font-sans uppercase tracking-[0.1em] text-center">
      <p>&copy; {currentYear} NO SE NO SENTIR. Todos los derechos reservados.</p>
    </div>

  </div>
</footer>