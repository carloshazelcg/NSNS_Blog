    75%  { transform: rotate(0deg)  translateY(-4px); }
    100% { transform: rotate(-8deg) translateY(0); }
  }

  .animate-bailar {
    animation: bailar 1.6s ease-in-out infinite;
    transform-origin: bottom center;
  }

  @keyframes marquee {
