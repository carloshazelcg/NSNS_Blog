<script is:inline define:vars={{ tracks }}>
  const trackEl = document.getElementById('track-name');
  if (trackEl) {
    let idx = 0;
    setInterval(() => {
      idx = (idx + 1) % tracks.length;
      trackEl.textContent = tracks[idx];
    }, 5000);
  }

  async function loadComments() {
    const list = document.getElementById('comments-list');
    try {
      const res = await fetch('/api/comments');
      const comments = await res.json();

      if (!Array.isArray(comments) || comments.length === 0) {
        list.innerHTML = '<p class="text-[#6a6a7a] text-[8px] md:text-xs">Sé el primero en comentar</p>';
        return;
      }

      list.innerHTML = comments.map(c => `
        <div class="border-b border-dashed border-[#3a3a5a] pb-1.5 md:pb-3">
          <div class="flex items-center gap-1 md:gap-2 mb-0.5 md:mb-1">
            <div class="w-4 h-4 md:w-6 md:h-6 bg-[#3a3a5a] border border-[#5a5a7a] flex items-center justify-center text-[7px] md:text-[10px] text-[#8a9aba] font-bold">
              ${escapeHtml(c.author).charAt(0).toUpperCase()}
            </div>
            <p class="text-[#8a9aba] font-bold text-[8px] md:text-xs">${escapeHtml(c.author)}</p>
            <p class="text-[#6a6a7a] text-[7px] md:text-[10px]">${new Date(c.created_at).toLocaleDateString('es-MX')}</p>
          </div>
          <p class="text-[#a0a0a0] text-[8px] md:text-xs pl-5 md:pl-8">${escapeHtml(c.body)}</p>
        </div>
      `).join('');
    } catch (e) {
      list.innerHTML = '<p class="text-red-400 text-[8px] md:text-xs">Error al cargar comentarios</p>';
    }
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  const form = document.getElementById('comment-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = document.getElementById('form-message');
      const formData = new FormData(form);

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();

        message.classList.remove('hidden');
        if (res.ok) {
          message.textContent = '✓ Comentario enviado. Pendiente de aprobación.';
          message.className = 'text-[8px] md:text-xs mt-1.5 md:mt-3 text-[#8aba8a]';
          form.reset();
          if (window.turnstile) window.turnstile.reset();
        } else {
          message.textContent = '✗ ' + (data.error || 'Error al enviar');
          message.className = 'text-[8px] md:text-xs mt-1.5 md:mt-3 text-red-400';
        }
      } catch (e) {
        message.textContent = '✗ Error de conexión';
        message.className = 'text-[8px] md:text-xs mt-1.5 md:mt-3 text-red-400';
        message.classList.remove('hidden');
      }
    });
  }

  loadComments();
</script>

<script is:inline>
  const floatingAd = document.getElementById('floating-ad');
  const adModal = document.getElementById('ad-modal');
  const openAdBtn = document.getElementById('open-ad-modal');
  const closeAdBtn = document.getElementById('close-ad');
  const closeModalBtn = document.getElementById('close-modal');

  if (floatingAd && adModal && openAdBtn && closeAdBtn && closeModalBtn) {
    openAdBtn.addEventListener('click', () => {
      adModal.classList.remove('hidden');
      adModal.classList.add('flex');
    });

    closeModalBtn.addEventListener('click', () => {
      adModal.classList.add('hidden');
      adModal.classList.remove('flex');
    });

    adModal.addEventListener('click', (e) => {
      if (e.target === adModal) {
        adModal.classList.add('hidden');
        adModal.classList.remove('flex');
      }
    });

    closeAdBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      floatingAd.remove();
      adModal.classList.add('hidden');
      adModal.classList.remove('flex');
    });
  }
</script>

