---
import Logo from "../assets/IMG_9954.png";

const navLinks = [
  { name: "Inicio", href: "/" },
  { name: "Nosotros", href: "/nosotros" }
];
---

<header id="main-nav" class="fixed top-0 left-0 w-full z-[1000] pointer-events-none flex justify-center items-start pt-4 md:pt-6">
  <div id="logo-container" class="pointer-events-auto flex items-center justify-center">
    <a href="/" class="group block">
      <img 
        src={Logo.src} 
        alt="NSNS Logo" 
        id="main-logo"
        class="h-28 md:h-36 w-auto object-contain transition-opacity duration-300 group-hover:opacity-80"
      />
    </a>
  </div>
</header>

<div 
  id="menu-btn-container" 
  class="fixed top-4 right-4 md:top-6 md:right-12 pointer-events-auto flex items-center justify-center p-2 bg-[#16161A]/80 backdrop-blur-md border border-[#94E2D5]/20 rounded-full shadow-2xl z-[1050]"
  style="width: 48px; height: 48px;"
>
  <button 
    id="menuToggle" 
    class="w-full h-full flex items-center justify-center rounded-full bg-transparent text-[#94E2D5] hover:text-[#C7B8EA] transition-colors focus:outline-none cursor-pointer relative"
    aria-expanded="false" 
    aria-label="Toggle Navigation"
  >
    <svg id="hamburgerIcon" class="w-5 h-5 absolute transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>

    <svg id="closeIcon" class="w-5 h-5 absolute opacity-0 transition-all scale-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>
</div>

<div id="menu-overlay" class="fixed inset-0 z-[1005] pointer-events-none" role="dialog" aria-modal="true">
  <div id="menu-backdrop" class="absolute inset-0 bg-[#16161A]/60 backdrop-blur-md opacity-0 transition-opacity"></div>
  
  <div 
    id="menu-panel" 
    class="fixed top-16 right-4 md:top-20 md:right-12 w-[calc(100vw-2rem)] sm:w-[320px] max-w-[340px] bg-[#242629]/90 backdrop-blur-xl border border-[#94E2D5]/30 rounded-2xl p-3 shadow-[0_10px_30px_rgba(22,22,26,0.8)] invisible pointer-events-auto origin-top-right z-[1010]"
  >
    <nav class="flex flex-col space-y-1">
      {navLinks.map((link) => (
        <a 
          class="menu-link group flex items-center justify-start p-3.5 md:p-4 rounded-xl text-[#94E2D5] hover:bg-[#16161A]/60 hover:text-[#C7B8EA] transition-all duration-200 text-base md:text-lg font-bold tracking-wider" 
          href={link.href} 
          tabindex="-1"
        >
          <span>{link.name}</span>
        </a>
      ))}
    </nav>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  let isOpen = false;
  let isScrolled = false;
  let tl: gsap.core.Timeline;

  const mainLogo = document.getElementById("main-logo");
  const toggleBtn = document.getElementById("menuToggle");
  const hamburgerIcon = document.getElementById("hamburgerIcon");
  const closeIcon = document.getElementById("closeIcon");
  const overlay = document.getElementById("menu-overlay");
  const backdrop = document.getElementById("menu-backdrop");
  const panel = document.getElementById("menu-panel");

  function buildTimeline() {
    if (tl) tl.revert();

    tl = gsap.timeline({ paused: true })
      .set(overlay, { pointerEvents: 'auto' })
      .to(hamburgerIcon, { opacity: 0, scale: 0.5, rotation: -90, duration: 0.25, ease: 'power2.in' }, 0)
      .to(closeIcon, { opacity: 1, scale: 1, rotation: 0, duration: 0.25, ease: 'back.out(1.7)' }, 0.1)
      .to(backdrop, { opacity: 1, duration: 0.3, ease: 'power2.out' }, 0)
      .fromTo(panel, 
        { autoAlpha: 0, yPercent: -8, scale: 0.95 }, 
        { 
          autoAlpha: 1, 
          yPercent: 0, 
          scale: 1, 
          duration: 0.4, 
          ease: 'back.out(1.5)', 
          easeReverse: 'power3.out' 
        }, 0.05)
      .fromTo('.menu-link', 
        { opacity: 0, y: 10 },
        { 
          opacity: 1, 
          y: 0, 
          duration: 0.25, 
          ease: 'power2.out', 
          stagger: 0.05, 
          easeReverse: 'power1.out' 
        }, 0.15);
  }

  buildTimeline();

  function toggleMenu() {
    isOpen = !isOpen;
    toggleBtn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    
    document.querySelectorAll('.menu-link').forEach(link => {
      link.setAttribute('tabindex', isOpen ? '0' : '-1');
    });

    if (isOpen) {
      tl.play();
    } else {
      tl.eventCallback('onReverseComplete', () => {
        gsap.set(overlay, { pointerEvents: 'none' });
      });
      tl.reverse();
    }
  }

  toggleBtn?.addEventListener('click', toggleMenu);
  backdrop?.addEventListener('click', () => { if (isOpen) toggleMenu(); });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      toggleMenu();
      toggleBtn?.focus();
    }
  });

  window.addEventListener('scroll', () => {
    const trigger = window.innerHeight * 0.15;
    const isMobile = window.innerWidth < 768;
    const contractedHeight = isMobile ? "72px" : "80px";
    const expandedHeight = isMobile ? "112px" : "144px";

    if (window.scrollY > trigger && !isScrolled) {
      isScrolled = true;
      gsap.to(mainLogo, { height: contractedHeight, duration: 0.4, ease: "power2.out" });
    } else if (window.scrollY <= trigger && isScrolled) {
      isScrolled = false;
      gsap.to(mainLogo, { height: expandedHeight, duration: 0.4, ease: "power2.out" });
    }
  });
</script>