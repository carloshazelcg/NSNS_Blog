---
import Logo from "../assets/IMG_9954.png";

const navLinks = [
  { name: "Inicio", href: "/" },
  { name: "Nosotros", href: "/nosotros" }
];
---

<header id="main-nav" class="fixed top-0 left-0 w-full z-[1000] pointer-events-none flex justify-center items-start pt-4 md:pt-6">
  <div id="logo-container" class="pointer-events-auto flex items-center justify-center">
    <a href="/" class="group block">
      <img 
        src={Logo.src} 
        alt="NSNS Logo" 
        id="main-logo"
        class="h-28 md:h-36 w-auto object-contain transition-opacity duration-300 group-hover:opacity-80"
      />
    </a>
  </div>
</header>

<div 
  id="menu-btn-container" 
  class="fixed top-4 right-4 md:top-6 md:right-12 pointer-events-auto flex items-center justify-center p-2 bg-[#0D0D0D]/90 backdrop-blur-md border border-[#732F3B]/40 rounded-full shadow-2xl z-[1050]"
  style="width: 48px; height: 48px;"
>
  <button 
    id="menuToggle" 
    class="w-full h-full flex items-center justify-center rounded-full bg-transparent text-[#F2F2F2] hover:text-[#73030D] transition-colors focus:outline-none cursor-pointer relative"
    aria-expanded="false" 
    aria-label="Toggle Navigation"
  >
    <svg id="hamburgerIcon" class="w-5 h-5 absolute transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>

    <svg id="closeIcon" class="w-5 h-5 absolute opacity-0 transition-all scale-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>
</div>

<div id="menu-overlay" class="fixed inset-0 z-[1005] hidden pointer-events-none" role="dialog" aria-modal="true">
  <div id="menu-backdrop" class="absolute inset-0 bg-[#0D0D0D]/80 backdrop-blur-md opacity-0 transition-opacity"></div>
  
  <div 
    id="menu-panel" 
    class="fixed top-16 right-4 md:top-20 md:right-12 w-[calc(100vw-2rem)] sm:w-[320px] max-w-[340px] bg-[#161314]/95 backdrop-blur-xl border border-[#732F3B]/40 rounded-2xl p-3 shadow-2xl invisible pointer-events-none origin-top-right z-[1010]"
  >
    <nav class="flex flex-col space-y-1">
      {navLinks.map((link) => (
        <a 
          class="menu-link group flex items-center justify-start p-3.5 md:p-4 rounded-xl text-[#F2F2F2] hover:bg-[#73030D]/20 hover:text-[#F2F2F2] transition-all duration-200 text-base md:text-lg font-medium tracking-wide border border-transparent hover:border-[#732F3B]/30" 
          href={link.href} 
          tabindex="-1"
        >
          <span>{link.name}</span>
        </a>
      ))}
    </nav>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  let cleanupNav: (() => void) | null = null;

  function initNavBar() {
    if (cleanupNav) cleanupNav();

    const toggleBtn = document.getElementById("menuToggle");
    const hamburgerIcon = document.getElementById("hamburgerIcon");
    const closeIcon = document.getElementById("closeIcon");
    const overlay = document.getElementById("menu-overlay");
    const backdrop = document.getElementById("menu-backdrop");
    const panel = document.getElementById("menu-panel");
    const mainLogo = document.getElementById("main-logo");

    if (!toggleBtn || !overlay || !panel) return;

    let isOpen = false;
    let isScrolled = false;

    const tl = gsap.timeline({ paused: true })
      .to(hamburgerIcon, { opacity: 0, scale: 0.5, rotation: -90, duration: 0.2, ease: 'power2.in' }, 0)
      .to(closeIcon, { opacity: 1, scale: 1, rotation: 0, duration: 0.2, ease: 'back.out(1.7)' }, 0.05)
      .to(backdrop, { opacity: 1, duration: 0.25, ease: 'power2.out' }, 0)
      .fromTo(panel, 
        { autoAlpha: 0, yPercent: -5, scale: 0.95 }, 
        { autoAlpha: 1, yPercent: 0, scale: 1, duration: 0.3, ease: 'back.out(1.2)' }, 0.05);

    function toggleMenu() {
      isOpen = !isOpen;
      toggleBtn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

      if (isOpen) {
        overlay?.classList.remove('hidden', 'pointer-events-none');
        overlay?.classList.add('pointer-events-auto');
        panel?.classList.remove('invisible', 'pointer-events-none');
        panel?.classList.add('visible', 'pointer-events-auto');
        tl.play();
      } else {
        tl.eventCallback('onReverseComplete', () => {
          overlay?.classList.remove('pointer-events-auto');
          overlay?.classList.add('hidden', 'pointer-events-none');
          panel?.classList.remove('visible', 'pointer-events-auto');
          panel?.classList.add('invisible', 'pointer-events-none');
        });
        tl.reverse();
      }
    }

    function handleScroll() {
      if (!mainLogo) return;
      const trigger = window.innerHeight * 0.15;
      const isMobile = window.innerWidth < 768;
      const contractedHeight = isMobile ? "72px" : "80px";
      const expandedHeight = isMobile ? "112px" : "144px";

      if (window.scrollY > trigger && !isScrolled) {
        isScrolled = true;
        gsap.to(mainLogo, { height: contractedHeight, duration: 0.3, ease: "power2.out" });
      } else if (window.scrollY <= trigger && isScrolled) {
        isScrolled = false;
        gsap.to(mainLogo, { height: expandedHeight, duration: 0.3, ease: "power2.out" });
      }
    }

    const onBackdropClick = () => { if (isOpen) toggleMenu(); };

    toggleBtn.addEventListener('click', toggleMenu);
    if (backdrop) backdrop.addEventListener('click', onBackdropClick);
    window.addEventListener('scroll', handleScroll, { passive: true });

    cleanupNav = () => {
      toggleBtn.removeEventListener('click', toggleMenu);
      if (backdrop) backdrop.removeEventListener('click', onBackdropClick);
      window.removeEventListener('scroll', handleScroll);
      tl.kill();
    };
  }

  initNavBar();
  document.addEventListener('astro:page-load', initNavBar);
</script>